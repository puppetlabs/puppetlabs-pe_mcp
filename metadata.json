{
  "name": "puppetlabs-pe_mcp",
  "version": "1.0.0",
  "author": "puppetlabs",
  "summary": "Bolt plans and Puppet classes for deploying and validating the PE MCP (Model Context Protocol) server on existing Puppet Enterprise infrastructure.",
  "license": "Apache-2.0",
  "source": "https://github.com/puppetlabs/puppetlabs-pe_mcp",
